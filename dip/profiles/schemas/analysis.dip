# Reusable runtime analysis contract. Compile-time capabilities remain in
# `build.analysis`; these values configure the enabled analysis algorithms.
# Arepo runtime parameter reference:
# https://arepo-code.org/wp-content/userguide/parameterfile.html
$schema subfind_analysis_settings

  linking_neighbors int
    !condition ({.} > 0)
    ?descr "Minimum number of particles/cells retained in a Subfind group."

  opening_angle float
    !condition ({.} > 0)
    ?descr "Subfind tree opening angle."

$schema analysis_settings

  subfind : subfind_analysis_settings
