# Reusable spatial-domain and integration-time contract.
# Arepo runtime parameter reference:
# https://arepo-code.org/wp-content/userguide/parameterfile.html
$schema simulation_box

  size float arepo_length
    !condition ({.} > 0 arepo_length)
    ?descr "Simulation-box edge length in the selected Arepo code-length unit."

$schema simulation_domain

  boundary str
    !options [
      "periodic",     # periodic domain boundaries
      "non_periodic"  # non-periodic domain boundaries
    ]
    ?descr "Whether the simulation domain has periodic boundaries."

  box : simulation_box

$schema simulation_time

  coordinate str
    !options [
      "scale_factor", # cosmological integration using scale factor
      "linear"        # non-cosmological integration using linear time
    ]
    ?descr "Independent coordinate used by the time integrator."

  initial_redshift float
    ?descr "Redshift represented by the initial conditions."

  final_redshift float
    ?descr "Redshift at which a cosmological integration ends."

  begin float
    ?descr "Initial integration coordinate; often derived from the initial redshift."

  end float
    !condition ({.} >= {?simulation.time.begin})
    ?descr "Final integration coordinate."

  maximum_step float
    !condition ({.} > 0)
    ?descr "Maximum permitted integration step."

  minimum_step float
    !condition ({.} >= 0)
    ?descr "Minimum permitted integration step; zero delegates the lower limit to Arepo."

  statistics_interval float
    !condition ({.} >= 0)
    ?descr "Interval between time-statistics reports."

  first_snapshot float
    ?descr "First regularly spaced snapshot time when no output schedule is used."

  snapshot_interval float
    !condition ({.} >= 0)
    ?descr "Spacing of regular snapshots when no output schedule is used."

  timestep_criterion int
    !options [
      0, # displacement-based criterion
      1  # acceleration-based criterion
    ]
    ?descr "Global time-step criterion used by Arepo."

$schema simulation_settings

  domain : simulation_domain
  time : simulation_time
