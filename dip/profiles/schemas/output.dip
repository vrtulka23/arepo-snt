# Reusable Arepo output contract. `snapshot_settings` is defined in snapshots.dip.
# Arepo runtime parameter reference:
# https://arepo-code.org/wp-content/userguide/parameterfile.html
$schema output_schedule_settings

  enabled bool = false
    ?descr "Whether Arepo reads an explicit output-time schedule file."
    ?native "OutputListOn"
    !tags ["arepo:param"]
    ?requires "output.schedule.filename"
    ?implies "output.schedule.filename"
    ?scientific_impact "Selects explicitly chosen output epochs instead of the regular cadence defined by simulation.time.first_snapshot and simulation.time.snapshot_interval."
    ?category "snapshot scheduling"

  filename str
    ?descr "Path to the output-time schedule file when scheduling is enabled."
    ?native "OutputListFilename"
    !tags ["arepo:param"]
    ?category "snapshot scheduling"

$schema output_settings

  schedule : output_schedule_settings
  snapshots : snapshot_settings
