# Fundamental cgs-scale code bases shared by the idealised Arepo examples.
code_units
  length float = 0.01 m
    ?descr "One Arepo length unit (one centimetre)."
    ?native "UnitLength_in_cm"
    !tags ["arepo:param"]
    ?rationale "Together with mass and velocity, this base determines Arepo's internal time unit."
    ?example "3.085678e21 cm corresponds to 1 kpc/h in Arepo's native convention."
    ?category "code units"
    export : arepo_export
      units = "cm"
  mass float = 0.001 kg
    ?descr "One Arepo mass unit (one gram)."
    ?native "UnitMass_in_g"
    !tags ["arepo:param"]
    ?rationale "Together with length and velocity, this base determines Arepo's internal time unit."
    ?example "1.989e43 g corresponds to 10^10 solar masses/h in Arepo's native convention."
    ?category "code units"
    export : arepo_export
      units = "g"
  velocity float = 0.01 m/s
    ?descr "One Arepo velocity unit (one centimetre per second)."
    ?native "UnitVelocity_in_cm_per_s"
    !tags ["arepo:param"]
    ?rationale "Together with length and mass, this base determines Arepo's internal time unit."
    ?example "1e5 cm/s corresponds to 1 km/s."
    ?category "code units"
    export : arepo_export
      units = "cm/s"
