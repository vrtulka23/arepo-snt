# The active setup is deliberately declared before feature-gated runtime data.
experiment
  setup
    kind str = "cosmological_star_formation"
      !options ["cosmological_star_formation","cosmological_gravity_only","mhd_shock_tube"]
      ?descr "Selects the scientific setup branch."
      ?url "https://arepo-code.org/wp-content/userguide/examples.html"

build : arepo_build
  physics
    cooling = true
    star_formation = true
  gravity
    self_gravity = true
    particle_mesh = true
      grid_resolution = 256
    softening_types = 2
  io
    hdf5 = true
    reduced_flush = true
  mesh
    face_angle_regularization = true
    refinement = true
    adaptive_hydro_softening = true

input
  initial_conditions
    path str = "./ics"
      ?descr "Initial-condition filename without the HDF5 suffix."
    format int = 1
      !options [1,2,3]

output
  schedule
    enabled bool = true
    filename str = "./output_list.txt"
  snapshots : snapshot_settings
    directory = "./output"
    base_name = "snap"
    format = 3
    files = 1
    parallel_files = 1

resources
  memory
    per_rank int = 2500
      ?descr "Memory allocated per MPI task in MiB."
  wall_clock
    limit float = 90000 s
    restart_interval float = 12000 s
    log_flush_interval float = 120 s
  execution
    resubmit bool = false
    resubmit_command str = "my-scriptfile"

simulation
  domain
    boundary str = "periodic"
      !options ["periodic","non_periodic"]
    box
      size float = 7500 arepo_length
        ?descr "Comoving cubic-box edge length in Arepo code units."
  time
    coordinate str = "scale_factor"
    initial_redshift float = 127
    final_redshift float = 0
    # Scale factors are DIPL-derived from redshift.
    begin float = ( 1 / ( 1 + {?simulation.time.initial_redshift} ) )
    end float = ( 1 / ( 1 + {?simulation.time.final_redshift} ) )
    maximum_step float = 0.005
    minimum_step float = 1e-9
    statistics_interval float = 0.01
    first_snapshot float = 0
    snapshot_interval float = 0
    timestep_criterion int = 0

cosmology : cosmology_settings
  matter_density = 0.3089
  baryon_density = 0.0486
  hubble_parameter = 0.6774
  initial_redshift = {?simulation.time.initial_redshift}
  final_redshift = {?simulation.time.final_redshift}
  flat bool = true
  dark_energy_density float = ( 1 - {?cosmology.matter_density} )
    !condition ({.} >= 0)
  dark_matter_density float = ( {?cosmology.matter_density} - {?cosmology.baryon_density} )
    !condition ({.} >= 0)

gravity : gravity_settings
  force_accuracy
    integration = 0.012
    opening_angle = 0.7
    relative_force = 0.0025
    opening_criterion = 1
  domain_decomposition
    multiple_domains = 8
    top_node_factor = 2.5
    active_fraction = 0.01
  softenings
    comoving list
    comoving[] float = 6 arepo_length
    comoving[] float = 6 arepo_length
    physical_maximum list
    physical_maximum[] float = 3 arepo_length
    physical_maximum[] float = 3 arepo_length
    particle_type_map int[6] = [0,1,1,1,1,1]
  hydro
    gas_softening_factor = 2.5
    minimum_comoving = 0.25 arepo_length
    spacing = 1.2

hydrodynamics : hydrodynamics_settings
  courant_factor = 0.3
  initial_gas_temperature = 244.8095 K
  minimum_gas_temperature = 5 K
  minimum_startup_density = 1e-20 arepo_density
  internal_energy_density_limit = 0
  internal_energy_floor = 0
  minimum_specific_energy = 0 arepo_specific_energy
  target_neighbors = 64
  maximum_neighbor_deviation = 4

mesh : mesh_settings
  regularization
    shaping_speed = 0.5
    maximum_face_angle_factor = 2.25

# The selected setup instantiates these feature schemas.  The catalog gates
# their native emission with the corresponding build capabilities.
mesh
  refinement
    reference_gas_mass = 0 arepo_mass
    target_gas_mass_factor = 1
    refinement_criterion = 1
    derefinement_criterion = 1

cooling
  enabled_at_runtime bool = true
    !condition ({.} == {?build.physics.cooling})
  uv_background_file str = "./TREECOOL_ep"
    ?descr "Cooling and UV-background table used by Arepo."

star_formation
  enabled_at_runtime bool = true
    !condition ({.} == {?build.physics.star_formation})
  critical_overdensity float = 57.7
  temperature_threshold float = 1e6 K
  critical_physical_density float = 0 kg/m3
  supernova_temperature float = 5.73e7 K
  cloud_temperature float = 1000 K
  maximum_timescale float = 2.27 arepo_time
  supernova_factor float = 0.1
  evaporation_factor float = 573

# Future alternate setup branches are kept separate from this active profile.
@if false
  mhd
    seed_field float = 0
@end
