# Semantic counterpart of examples/cosmo_box_gravity_only_3d.
experiment
  setup
    kind str = "cosmological_gravity_only"
      !options ["cosmological_star_formation","cosmological_gravity_only","mhd_shock_tube"]
      ?descr "A periodic cosmological volume with collisionless TreePM gravity."
      ?url "https://arepo-code.org/wp-content/userguide/simtypes.html"

build : arepo_build
  physics
    cooling = false
    star_formation = false
  gravity
    self_gravity = true
    hierarchical = true
    cell_center_evaluation = true
    direct_summation = true
      threshold = 500
    multiple_node_softening = true
    individual_softening_type_mask = 32
    particle_mesh = true
      grid_resolution = 256
      short_range_cutoff = 5.0
    softening_types = 2
  time
    tree_based_timesteps = true
  precision
    mode = 1
    fftw_double = true
    neighbor_tree_double = true
  io
    hdf5 = true
    reduced_flush = true
    output_coordinates_double = true
  mesh
    face_angle_regularization = false
    refinement = false
    adaptive_hydro_softening = true
  analysis
    fof = true
      primary_link_type_mask = 2
      secondary_link_type_mask = 49
    subfind = true
      save_density_estimates = true
      calculate_velocity_dispersion = true
      extended_properties = true
  output
    process_schedule_exactly = true
  diagnostics
    debug = true

input
  initial_conditions
    path str = "./ics"
      ?descr "Collisionless cosmological initial-condition file."
    format int = 1
      !options [1,2,3]

output
  schedule
    enabled bool = true
    filename str = "./output_list.txt"
  snapshots : snapshot_settings
    directory = "./output"
    base_name = "snap"
    format = 3
    files = 1
    parallel_files = 1

resources
  memory
    per_rank int = 2500
  wall_clock
    limit float = 93000 s
    restart_interval float = 12000 s
    log_flush_interval float = 120 s
  execution
    resubmit bool = false
    resubmit_command str = "my-scriptfile"

simulation
  domain
    boundary str = "periodic"
      !options ["periodic","non_periodic"]
    box
      size float = 50000 arepo_length
        ?descr "Comoving box edge in Arepo code units (50 Mpc)."
  time
    coordinate str = "scale_factor"
    initial_redshift float = 127
    final_redshift float = 0
    begin float = ( 1 / ( 1 + {?simulation.time.initial_redshift} ) )
    end float = ( 1 / ( 1 + {?simulation.time.final_redshift} ) )
    maximum_step float = 0.005
    minimum_step float = 2e-9
    statistics_interval float = 0.01
    first_snapshot float = 0
    snapshot_interval float = 0
    timestep_criterion int = 0

cosmology : cosmology_settings
  matter_density = 0.3089
  baryon_density = 0
  hubble_parameter = 0.6774
  initial_redshift = {?simulation.time.initial_redshift}
  final_redshift = {?simulation.time.final_redshift}
  flat bool = true
  dark_energy_density float = ( 1 - {?cosmology.matter_density} )
    !condition ({.} >= 0)
  dark_matter_density float = ( {?cosmology.matter_density} - {?cosmology.baryon_density} )
    !condition ({.} >= 0)

gravity : gravity_settings
  force_accuracy
    integration = 0.012
    opening_angle = 0.7
    relative_force = 0.0025
    opening_criterion = 1
  domain_decomposition
    multiple_domains = 4
    top_node_factor = 2.5
    active_fraction = 0.01
  softenings
    comoving list
    comoving[] float = 40 arepo_length
    comoving[] float = 40 arepo_length
    physical_maximum list
    physical_maximum[] float = 20 arepo_length
    physical_maximum[] float = 20 arepo_length
    particle_type_map int[6] = [0,1,1,1,1,1]
  hydro
    gas_softening_factor = 2.5
    minimum_comoving = 1 arepo_length
    spacing = 1.2

hydrodynamics : hydrodynamics_settings
  courant_factor = 0.3
  initial_gas_temperature = 244.8095 K
  minimum_gas_temperature = 5 K
  minimum_startup_density = 1e-20 arepo_density
  internal_energy_density_limit = 0
  internal_energy_floor = 0
  minimum_specific_energy = 0 arepo_specific_energy
  target_neighbors = 64
  maximum_neighbor_deviation = 4

mesh : mesh_settings
  regularization
    shaping_speed = 0.5
    shaping_factor = 1.0

analysis
  subfind
    linking_neighbors int = 20
      ?descr "Minimum number of particles/cells retained in a Subfind group."
    opening_angle float = 0.7
      ?descr "Subfind tree opening angle."
