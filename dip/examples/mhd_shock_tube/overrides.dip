# Fine tuning for mhd_shock_tube only.
# Uncomment $override and the assignments you want; an empty block is invalid.
# Each target may occur only once. Assign existing values without type declarations.
# Tune inputs rather than replacing their derived values.
#
# $override
#   resources
#     memory
#       per_rank = 2000
#     wall_clock
#       limit = 3600 s
#   hydrodynamics
#     courant_factor = 0.25
#   simulation
#     domain
#       box
#         size = 10000 arepo_length
